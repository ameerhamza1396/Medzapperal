Options -MultiViews
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^api/imagekit-auth$ api/imagekit-auth/index.php [L]
  RewriteRule ^api/customer-imagekit-auth$ api/customer-imagekit-auth/index.php [L]
  RewriteRule ^api/imagekit-delete$ api/imagekit-delete/index.php [L]
  RewriteRule ^api/order-received-email$ api/order-received-email/index.php [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|webp|avif|svg|mp4|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-store"
  </FilesMatch>
</IfModule>
